                  ]
                },
                {
                  "type": "frame",
                  "id": "yxIPX",
                  "name": "EditorBody",
                  "width": "fill_container",
                  "height": "fill_container",
                  "layout": "vertical",
                  "gap": 18,
                  "children": [
                    {
                      "type": "text",
                      "id": "kdRg6",
                      "name": "Para1",
                      "fill": "#1A2E28",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "陆沉握紧青铜残剑，指腹摩挲过剑身凹凸的铭文。观星台外，夜风卷起碎石，像有人在低声念一段被遗忘的咒文。",
                      "lineHeight": 1.85,
                      "fontFamily": "Newsreader",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Hcaht",
                      "name": "Para2",
                      "fill": "#1A2E28",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "「第七星渊」——这三个字在他眼前忽然亮起，像墨迹被无形的手重新描了一遍。远处山脊上，一盏青灯忽明忽灭。",
                      "lineHeight": 1.85,
                      "fontFamily": "Newsreader",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "A1V8Hp",
                      "name": "Para3",
                      "fill": "#1A2E28",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "他想起师父临终前的话：剑在人在，渊碎道不碎。可此刻残剑轻颤，仿佛在提醒他——有什么东西，正在从星渊深处醒来。",
                      "lineHeight": 1.85,
                      "fontFamily": "Newsreader",
                      "fontSize": 16,
                      "fontWeight": "normal"
